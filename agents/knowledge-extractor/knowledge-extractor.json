{
  "name": "knowledge-extractor",
  "description": "Reads an indexed document and extracts structured knowledge entities: equipment, parts, procedures, specs, safety rules, parameters, chemicals, tools, and warnings.",
  "instruction": { "$file": "instruction.md" },
  "toolsets": ["POD"],
  "input_schema": {
    "type": "object",
    "properties": {
      "document_id": { "type": "string" },
      "file_path": { "type": "string" }
    },
    "required": ["document_id", "file_path"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "entities": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "attributes": { "type": "object" },
            "source_page": { "type": "integer" },
            "confidence": { "type": "number" }
          },
          "required": ["type", "name", "source_page", "confidence"]
        }
      },
      "equipment_found": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "category": { "type": "string" },
            "manufacturer": { "type": "string" },
            "model": { "type": "string" },
            "description": { "type": "string" },
            "specifications": { "type": "object" }
          },
          "required": ["name", "category"]
        }
      },
      "procedures_found": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "procedure_type": { "type": "string" },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "order": { "type": "integer" },
                  "description": { "type": "string" }
                }
              }
            },
            "risk_level": { "type": "string" }
          },
          "required": ["title", "procedure_type", "steps"]
        }
      },
      "total_entities": { "type": "integer" }
    },
    "required": ["entities", "total_entities"]
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "documents",
        "permission_ids": ["datastore.table.read", "datastore.record.read"]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "knowledge_entities",
        "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "equipment",
        "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "procedures",
        "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"]
      },
      { "resource_type": "folder", "resource_name": "/manuals", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/procedures", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/safety", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/specifications", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/reports", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/drawings", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/training", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/knowledge", "permission_ids": ["folder.read"] },
      { "resource_type": "folder", "resource_name": "/inbox", "permission_ids": ["folder.read"] }
    ]
  }
}
