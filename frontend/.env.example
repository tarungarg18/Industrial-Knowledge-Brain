# Copy this file to .env.local and fill in your values
# Run `lemma pod list` to get your pod ID
# These are injected by `lemma apps deploy` automatically when deploying to Lemma hosting
# You only need to set these manually for local dev

VITE_LEMMA_API_URL=https://api.lemma.work
VITE_LEMMA_AUTH_URL=https://lemma.work/auth
VITE_LEMMA_POD_ID=your-pod-id-here

# Only needed if running your own backend (backend/ directory)
# Leave empty if using Lemma SDK directly from the frontend
VITE_API_BASE=
